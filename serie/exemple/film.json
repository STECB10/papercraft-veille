  "sentences": [
    {"text": "Moins d'une personne sur cinq.", "box": "personne"},
    {"text": "En Tanzanie, c'est la part des patients diabétiques qui vont chez l'ophtalmologue quand leur dépistage le demande.", "box": "l'ophtalmologue"},
    {"text": "Le parcours habituel est long.", "box": "long."},
    {"text": "Une photo des yeux.", "box": "photo"},
    {"text": "Une lecture par un expert, plus tard.", "box": "expert,"},
    {"text": "Un appel, des semaines après.", "box": "semaines"},
    {"text": "Une équipe a voulu raccourcir ce chemin.", "mode": "type"},
    {"text": "Deux mille trois cent soixante-dix-huit patients tirés au sort.", "box": "sort.", "display": "2 378 patients tirés au sort."},
    {"text": "Pour la moitié, une IA lit les photos sur place.", "box": "IA"},
    {"text": "Le résultat est expliqué avant de partir, en face à face.", "box": "face."},
    {"text": "Trente-six pour cent vont alors à la consultation.", "box": "consultation.", "display": "36 % vont alors à la consultation."},
    {"text": "Contre dix-huit avec le parcours habituel.", "box": "habituel.", "display": "Contre 18 % avec le parcours habituel."},
    {"text": "Presque deux fois plus.", "peak": "deux fois"},
    {"text": "L'essai ne dit pas si l'IA voit mieux.", "mode": "type"},
    {"text": "Il montre qu'un résultat immédiat fait venir les patients.", "box": "immédiat"},
    {"text": "Mais plus de six sur dix manquent encore le rendez-vous.", "box": "rendez-vous.", "display": "Mais plus de 6 sur 10 manquent encore le rendez-vous."},
    {"text": "Une étude par jour, vérifiée à la source.", "mode": "none"},
    {"text": "Papercraft.", "mode": "none"}
  ],
