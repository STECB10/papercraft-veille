{
 "id": "2026-10-24",
 "sentences": [
  {
   "text": "Quarante pour cent seulement.",
   "display": "40 % seulement.",
   "box": "seulement."
  },
  {
   "text": "Ce sont des patients âgés, atteints d'une maladie rénale avancée.",
   "box": "avancée."
  },
  {
   "text": "Un an après, c'est la part dont le dossier note leurs souhaits de soins.",
   "box": "souhaits",
   "pause_apres": 2.5
  },
  {
   "text": "Avec les soins habituels.",
   "box": "habituels."
  },
  {
   "text": "Pourtant, ils devront bientôt choisir parmi trois options.",
   "box": "trois"
  },
  {
   "text": "L'hémodialyse."
  },
  {
   "text": "La dialyse par le ventre."
  },
  {
   "text": "Ou des soins sans dialyse.",
   "peak": "sans dialyse",
   "pause_apres": 0.3
  },
  {
   "text": "Une simple vidéo peut-elle ouvrir la discussion ?",
   "mode": "type",
   "pause_apres": 1.4
  },
  {
   "text": "C'est un essai tiré au sort, dans douze cliniques.",
   "box": "sort,"
  },
  {
   "text": "Quatre cent cinquante-trois patients de plus de soixante-cinq ans.",
   "display": "453 patients de plus de 65 ans.",
   "box": "patients"
  },
  {
   "text": "Le critère : les souhaits de soins notés au dossier, en un an.",
   "box": "dossier,"
  },
  {
   "text": "Des relecteurs, aidés d'un outil de langage, ne savent pas qui a vu la vidéo.",
   "box": "outil"
  },
  {
   "text": "Le groupe un regarde une vidéo sur trois options de traitement.",
   "box": "vidéo"
  },
  {
   "text": "Il enregistre ensuite un message de ses souhaits.",
   "box": "message"
  },
  {
   "text": "Ce message est envoyé à son médecin.",
   "box": "médecin."
  },
  {
   "text": "Le groupe deux reçoit les soins habituels.",
   "box": "habituels."
  },
  {
   "text": "Au bout d'un an, cinquante-sept pour cent des dossiers du groupe un notent leurs souhaits.",
   "display": "Au bout d'un an, 56,6 % des dossiers du groupe 1 notent leurs souhaits.",
   "box": "dossiers"
  },
  {
   "text": "Contre quarante pour cent avec les soins habituels.",
   "display": "Contre 40 % avec les soins habituels.",
   "box": "habituels."
  },
  {
   "text": "Soit seize virgule six points de plus.",
   "display": "Soit +16,6 points de plus.",
   "peak": "points"
  },
  {
   "text": "L'intervalle de confiance va de sept virgule cinq à vingt-cinq virgule sept.",
   "display": "L'intervalle de confiance à 95 % va de 7,5 à 25,7.",
   "box": "L'intervalle"
  },
  {
   "text": "Après la vidéo, treize pour cent hésitent encore sur leur choix, contre quarante et un.",
   "display": "Après la vidéo, 13,2 % hésitent encore sur leur choix, contre 41,3 %.",
   "box": "hésitent"
  },
  {
   "text": "L'essai mesure les notes au dossier, pas la qualité des soins.",
   "mode": "type"
  },
  {
   "text": "Une vidéo a donc fait noter plus de souhaits au dossier.",
   "peak": "plus",
   "pause_apres": 0.3
  },
  {
   "text": "Une étude par jour, vérifiée à la source.",
   "mode": "none"
  },
  {
   "text": "Papercraft.",
   "mode": "none"
  }
 ],
